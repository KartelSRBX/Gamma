    {
      "id": 10,
      "type": "table",
      "title": "Metrics",
      "description": "Metrics with CUPED are shown as covariate-adjusted means. Guardrail 'inconclusive' is not a pass.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT role AS Role, metric AS Metric, mean_control AS Control, mean_treatment AS Treatment, rel_diff AS Change, rel_ci_low AS Low, rel_ci_high AS High, if(p < 0.0001, '<0.0001', toString(round(p, 4))) AS p, if(p_adjusted IS NULL, '', if(p_adjusted < 0.0001, '<0.0001', toString(round(p_adjusted, 4)))) AS `Holm p`, guardrail AS Guardrail FROM gamma.v_latest_results WHERE experiment = '$experiment' AND dimension = 'all' ORDER BY multiIf(role = 'primary', 0, role = 'secondary', 1, 2), metric",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Change|Low|High"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Control|Treatment"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Change by metric",
      "description": "Point estimates only (intervals are in the table). GGR is left out: its interval is tens of percent wide, which flattens everything else.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"

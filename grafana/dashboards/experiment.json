        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Treatment share of players enrolled so far",
      "description": "Cumulative over the enrollment. It should sit on the planned split from the first day; a drift is a sampling or logging bug.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT day AS time, sum(treated) OVER (ORDER BY day) / sum(total) OVER (ORDER BY day) AS share FROM ( SELECT toStartOfDay(exposed_at) AS day, countIf(variant != 'control') AS treated, count() AS total FROM gamma.mart_user_metrics WHERE experiment = '$experiment' GROUP BY day ) ORDER BY day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0.4,
          "max": 0.6
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Players enrolled per day",
      "description": "Players by day of first exposure and arm. Falls fast: most players visit in the first days.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(exposed_at) AS time, variant, count() AS players FROM gamma.mart_user_metrics WHERE experiment = '$experiment' GROUP BY time, variant ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,

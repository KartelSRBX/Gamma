    {
      "id": 2,
      "type": "stat",
      "title": "Decision",
      "description": "The verdict of the latest run of `gamma report --save`. Rules: gamma/verdict.py.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT decision FROM gamma.v_latest_run WHERE experiment = '$experiment'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "SHIP": {
                  "color": "#73BF69",
                  "text": "SHIP"
                },
                "DO_NOT_SHIP": {
                  "color": "#F2495C",
                  "text": "DO NOT SHIP"
                },
                "INVALID": {
                  "color": "#F2495C",
                  "text": "INVALID"
                },
                "WAIT": {
                  "color": "#FF9830",
                  "text": "WAIT"
                },
                "HOLD": {
                  "color": "#FF9830",
                  "text": "HOLD"
                },
                "INCONCLUSIVE": {
                  "color": "#FF9830",
                  "text": "INCONCLUSIVE"
                },
                "NO_EFFECT": {
                  "color": "#5794F2",
                  "text": "NO EFFECT"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^decision$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },

          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dimension AS Dimension, value AS Segment, n_control AS `Control n`, n_treatment AS `Treatment n`, rel_diff AS Change, rel_ci_low AS Low, rel_ci_high AS High, if(p_adjusted < 0.0001, '<0.0001', toString(round(p_adjusted, 4))) AS `Holm p` FROM gamma.v_latest_results WHERE experiment = '$experiment' AND role = 'segment' ORDER BY dimension, value",

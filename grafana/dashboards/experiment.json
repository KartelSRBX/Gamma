          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT metric, rel_diff AS change FROM gamma.v_latest_results WHERE experiment = '$experiment' AND dimension = 'all' AND metric NOT IN ('ggr_per_player') ORDER BY metric",
          "refId": "A"
